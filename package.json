{
  "name": "content-calendar-audit-engine",
  "version": "1.0.0",
  "description": "Website Content Calendar & Multi-Dimensional Content Audit Engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => { fs.mkdirSync('dist/frontend',{recursive:true}); fs.copyFileSync('src/frontend/index.html','dist/frontend/index.html'); })\"",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.3.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
